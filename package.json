{
  "name": "pacevault",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run -F @pacevault/web dev",
    "check": "vp run @pacevault/i18n#compile && vp run -F '@pacevault/*' check",
    "test": "vp run @pacevault/i18n#compile && vp run -F '@pacevault/*' test",
    "build": "vp run -F '@pacevault/*' build",
    "e2e": "vp run -F @pacevault/web e2e",
    "workbench": "vp run -F @pacevault/workbench dev",
    "workbench:check": "vp run @pacevault/i18n#compile && vp run -F @pacevault/workbench check && vp run -F @pacevault/workbench plans:check",
    "workbench:cleanup": "vp run -F @pacevault/workbench cleanup",
    "workbench:deps": "vp run -F @pacevault/workbench deps",
    "workbench:interfaces": "vp run -F @pacevault/workbench interfaces",
    "workbench:capture": "vp run -F @pacevault/workbench capture",
    "docs:banner": "vp run -F @pacevault/docs banner"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.32.1"
}
