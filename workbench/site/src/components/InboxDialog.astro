---
import type { InboxItem } from '../../../../scripts/workbenchFrontmatter.ts';
import { renderMarkdown } from '../lib/board.ts';
import DeleteButton from './DeleteButton.astro';
import Peek from './Peek.astro';
import StatusIcon from './StatusIcon.astro';

/** One Inbox bullet of ideas.md, read-only; Delete in the header ("Decided by agents" too). */
type Props = { item: InboxItem; prev: InboxItem | undefined; next: InboxItem | undefined };
const props = Astro.props as Props;
const item = props.item;
const id = `dlg-${item.id}`;
const pill: Record<InboxItem['section'], string> = {
  'to decide': 'to decide',
  investigate: 'investigate',
  idea: 'idea',
  agents: 'by agents',
};
const agents = item.section === 'agents';
let html = '<p><span class="wb-muted">No further notes.</span></p>';
if (item.body !== '') html = renderMarkdown(item.body).trim();
---

<dialog id={id} class="wb-dlg wb-dlg--text" data-bucket={agents ? 'inbox-agents' : 'inbox'} closedby="any" aria-labelledby={`${id}-title`}>
  {props.prev && <Peek title={props.prev.title} bucket="inbox" step={-1} />}
  <div class="wb-dlg__panel">
    <header class="wb-dlg__head">
      <span class="wb-pill"><StatusIcon bucket="inbox" />{pill[item.section]}</span>
      <h2 id={`${id}-title`} class="wb-dlg__title">{item.title}</h2>
      <DeleteButton action="inbox.delete" fields={{ heading: item.heading, expected: item.raw }} label="Delete this bullet from ideas.md (Undo in the toast)" />
      <button type="button" class="wb-dlg__close" commandfor={id} command="close" aria-label="Close">✕</button>
    </header>
    <div class="wb-dlg__body">
      <section class="wb-pane wb-pane--plan">
        <article class="wb-md">
          <Fragment set:html={html} />
          <p class="wb-muted">From <code>workbench/ideas.md</code> · {item.heading}</p>
        </article>
      </section>
    </div>
  </div>
  {props.next && <Peek title={props.next.title} bucket="inbox" step={1} />}
</dialog>
