---
import type { FeatureView } from '../lib/board.ts';

/**
 * The Tech tab: `tech.md` rendered by Astro (Shiki github-dark; Mermaid blocks left as code),
 * drawn with Mermaid + ELK in the browser on the first open. The `template` carries the actual
 * import graph (`review/deps.mmd`, `deps.json`) for the Planned · Actual toggle in Modules.
 */
type Props = { feature: FeatureView };
const props = Astro.props as Props;
const f = props.feature;
const graph = f.graph;
const json = graph?.json;
const violations = json?.boundary.violations ?? [];
---

<article class="wb-md tt-md" data-tech={f.folder}><slot /></article>
<template data-actual-for={f.folder}>
  <figure class="tt-fig tt-actual" data-block="actual">
    {graph && (
      <>
        <figcaption class="tt-fig__cap"><strong>Actual</strong> · <code>review/deps.mmd</code>{json && ` · ${json.generated}`}</figcaption>
        <div data-graph="actual" data-title="Actual imports · review/deps.mmd"></div>
        <pre hidden data-mmd>{graph.mmd}</pre>
        {json && <p class="tt-counts"><span>Drawn: {json.nodes} modules · {json.edges} imports</span></p>}
        <p class="tt-legend">
          <span><i class="tt-sw tt-sw--focus"></i>focus</span>
          <span><i class="tt-sw tt-sw--added"></i>imported, not planned{json && <b> ({json.added.length})</b>}</span>
          <span><i class="tt-sw tt-sw--missing"></i>planned, not in the graph{json && <b> ({json.missing.length})</b>}</span>
        </p>
      </>
    )}
    {!graph && (
      <p class="tt-placeholder">Generated at review: <code>vp run workbench:deps -- {f.folder}</code> writes <code>review/deps.mmd</code>.</p>
    )}
  </figure>
  {json && violations.length === 0 && (
    <p class="tt-check" data-block="check"><span class="tt-check__ok">✔</span><span><strong>Boundary check</strong> · <code>{json.boundary.rules.join(', ')}</code>: no violations ({json.boundary.modules} modules, {json.boundary.dependencies} dependencies cruised)</span></p>
  )}
  {json && violations.length > 0 && (
    <div class="tt-check" data-block="check">
      <span class="wbx-err">✕</span>
      <span><strong>Boundary check</strong> · {violations.length} violation(s): {violations.map((violation) => `${violation.rule}: ${violation.from} → ${violation.to}`).join('; ')}</span>
    </div>
  )}
</template>
