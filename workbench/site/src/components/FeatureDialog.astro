---
import { LABELS, SLOTS, SLOT_LABEL, SLOT_MISSING, firstSlot, type FeatureView } from '../lib/board.ts';
import AnswerDialog from './AnswerDialog.astro';
import DeleteButton from './DeleteButton.astro';
import MockupPane from './MockupPane.astro';
import Peek from './Peek.astro';
import PlanPane from './PlanPane.astro';
import ReviewPane from './ReviewPane.astro';
import SlotIcon from './SlotIcon.astro';
import StatusIcon from './StatusIcon.astro';
import TechPane from './TechPane.astro';

/**
 * One feature: tabs Mockup · Plan · Tech · Review in fixed slots (missing ones greyed and
 * disabled), Mockup opens first; peeks to the neighbours of the same column. `tech` slot:
 * the rendered tech.md. Delete in the header finishes the feature (the folder goes to the trash).
 */
type Props = {
  feature: FeatureView;
  prev: FeatureView | undefined;
  next: FeatureView | undefined;
};
const props = Astro.props as Props;
const f = props.feature;
const id = `dlg-${f.folder}`;
const first = firstSlot(f);
---

<dialog id={id} class="wb-dlg" data-bucket={f.data.status} closedby="any" aria-labelledby={`${id}-title`}>
  {SLOTS.map((slot) => (
    <input type="radio" class={`wb-tab wb-tab--${slot}`} data-tab={slot} name={`tab-${f.folder}`} id={`tab-${f.folder}-${slot}`} aria-label={slot} checked={slot === first} disabled={!f.has[slot]} />
  ))}
  {props.prev && <Peek title={props.prev.data.title} bucket={props.prev.data.status} step={-1} />}
  <div class="wb-dlg__panel">
    <header class="wb-dlg__head">
      <span class="wb-pill" title="Drag the card on the board to change the status"><StatusIcon bucket={f.data.status} />{LABELS[f.data.status]}</span>
      <h2 id={`${id}-title`} class="wb-dlg__title">{f.data.title}</h2>
      <DeleteButton action="feature.delete" fields={{ feature: f.folder }} label={`Delete workbench/${f.folder}/ (finishes the feature; Undo in the toast)`} />
      <button type="button" class="wb-dlg__close" commandfor={id} command="close" aria-label="Close">✕</button>
    </header>
    <div class="wb-dlg__tabs">
      <nav class="wb-tabs" aria-label="Sections">
        {SLOTS.map((slot) => (
          <label class:list={[`wb-tabs__${slot}`, { 'tt-tab--grey': !f.has[slot] }]} for={`tab-${f.folder}-${slot}`} title={f.has[slot] ? undefined : SLOT_MISSING[slot]}>
            <span class:list={['tt-slot', 'tt-tabicon', f.has[slot] ? 'is-on' : 'is-off']}><SlotIcon slot={slot} /></span><span>{SLOT_LABEL[slot]}</span>
          </label>
        ))}
      </nav>
    </div>
    <div class="wb-dlg__body">
      <section class="wb-pane wb-pane--mockup">{f.has.mockup && <MockupPane feature={f} />}</section>
      <section class="wb-pane wb-pane--plan"><PlanPane feature={f} /></section>
      <section class="wb-pane wb-pane--tech">{f.has.tech && <TechPane feature={f}><slot name="tech" /></TechPane>}</section>
      <section class="wb-pane wb-pane--review">{f.has.review && <ReviewPane feature={f} />}</section>
    </div>
  </div>
  {props.next && <Peek title={props.next.data.title} bucket={props.next.data.status} step={1} />}
  {f.questions.filter((question) => question.open).map((question) => <AnswerDialog feature={f.folder} question={question} />)}
</dialog>
