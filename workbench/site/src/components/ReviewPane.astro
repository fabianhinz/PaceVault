---
import { inlineMarkdown, type FeatureView } from '../lib/board.ts';
import CheckRow from './CheckRow.astro';
import DeleteButton from './DeleteButton.astro';

/**
 * The Review tab: the review doc in an iframe and the findings panel (`review/findings.md`,
 * written by agents from your R-labelled findings) with Accept: tick the checks, then delete
 * the card.
 */
type Props = { feature: FeatureView };
const props = Astro.props as Props;
const f = props.feature;
const path = `workbench/${f.folder}/review/findings.md`;
---

<div class="wbx-rv">
  <div class="wbx-rv__doc">
    <iframe data-src={`/${f.folder}/review/index.html`} title={`${f.data.title} · review`}></iframe>
  </div>
  <aside class="wbx-findings" aria-label="Findings">
    <p class="wbx-side__title">Findings</p>
    <p class="wbx-side__sub"><code>{path}</code></p>
    {f.findings.length === 0 && <p class="wbx-empty">No findings yet.</p>}
    {f.findings.length > 0 && (
      <ul class="wbx-findings__list">
        {f.findings.map((finding) => (
          <li>
            <div class="wbx-item">
              <span class="rv-chip">{finding.id}</span>
              <span class="wbx-item__text"><span class="wb-muted">{finding.on === undefined ? 'general' : `on ${finding.on}`} · {finding.state} · </span><Fragment set:html={inlineMarkdown(finding.text)} /></span>
              <span class="wbx-acts"><DeleteButton action="review.deleteFinding" fields={{ feature: f.folder, expected: finding.raw, heading: finding.heading }} label={`Delete ${finding.id}`} /></span>
            </div>
          </li>
        ))}
      </ul>
    )}
    <div class="wbx-accept">
      <p class="wbx-side__title">Accept</p>
      <p class="wbx-side__sub">Tick the real-data checks, then delete the card (bin next to the title) to finish the feature.</p>
      {f.checks.length === 0 && <p class="wbx-empty">No real-data checks.</p>}
      {f.checks.length > 0 && <ul class="wbx-items">{f.checks.map((item) => <CheckRow feature={f.folder} item={item} kind="check" actions={false} />)}</ul>}
    </div>
  </aside>
</div>
