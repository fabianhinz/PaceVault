---
import { INBOX_GROUPS, STATUSES, type InboxItem } from '../../../../scripts/workbenchFrontmatter.ts';
import { LABELS, SLOTS, SLOT_LABEL, SLOT_MISSING, type FeatureView } from '../lib/board.ts';
import SlotIcon from './SlotIcon.astro';
import StatusIcon from './StatusIcon.astro';

/**
 * Inbox + one column per status except done; every column the same width (workbench.css).
 * Feature cards drag onto the columns in `data-moves`; Inbox cards do not drag.
 */
type Props = { features: FeatureView[]; inbox: InboxItem[] };
const props = Astro.props as Props;
const columns = STATUSES.filter((status) => status !== 'done');
const plural = (count: number, one: string, many: string) => `${count} ${count === 1 ? one : many}`;
const flags = (feature: FeatureView) => {
  const out: { kind: string; text: string }[] = [];
  const open = feature.questions.filter((question) => question.open).length;
  if (open > 0) out.push({ kind: 'open', text: `${open} open` });
  const calls = feature.agent.filter((item) => !item.checked).length;
  if (calls > 0) out.push({ kind: 'agent', text: plural(calls, 'agent call', 'agent calls') });
  const findings = feature.findings.filter((finding) => finding.state === 'open').length;
  if (findings > 0) out.push({ kind: 'open', text: plural(findings, 'finding', 'findings') });
  return out;
};
const slotsLabel = (feature: FeatureView) =>
  SLOTS.map((slot) => (feature.has[slot] ? SLOT_LABEL[slot] : SLOT_MISSING[slot])).join(', ');
const agents = props.inbox.filter((item) => item.section === 'agents');
// the count leaves out the collapsed agents group, as on the old board
const count = props.inbox.length - agents.length;
---

<main class="wb-board" aria-label="Board">
  <section class="wb-col" aria-label="Inbox" data-col="inbox">
    <h2 class="wb-col__head">
      <StatusIcon bucket="inbox" /><span>Inbox</span><span class="wb-col__count">{count}</span>
    </h2>
    <ul class="wb-col__list">
      {INBOX_GROUPS.filter((group) => group.section !== 'agents').map((group) => {
        const cards = props.inbox.filter((item) => item.section === group.section);
        if (cards.length === 0) return null;
        return (
          <>
            <li class="wb-group" role="presentation"><h3 class="wb-group__head">{group.label}</h3></li>
            {cards.map((item) => (
              <li><button type="button" class="wb-card" commandfor={`dlg-${item.id}`} command="show-modal"><span class="wb-card__title">{item.title}</span></button></li>
            ))}
          </>
        );
      })}
      {agents.length > 0 && (
        <>
          <li class="wb-group" role="presentation"><button type="button" class="wbx-group-toggle" data-agents-toggle aria-expanded="false">▸ Decided by agents · {agents.length}</button></li>
          {agents.map((item) => (
            <li class="wbx-agent-card" hidden><button type="button" class="wb-card" commandfor={`dlg-${item.id}`} command="show-modal"><span class="wb-card__title">{item.title}</span></button></li>
          ))}
        </>
      )}
    </ul>
  </section>
  {columns.map((status) => {
    const cards = props.features.filter((feature) => feature.data.status === status);
    return (
      <section class="wb-col" aria-label={LABELS[status]} data-col={status}>
        <h2 class="wb-col__head"><StatusIcon bucket={status} /><span>{LABELS[status]}</span><span class="wb-col__count">{cards.length}</span></h2>
        <ul class="wb-col__list">
          {cards.map((feature) => (
            <li>
              <button type="button" class="wb-card" commandfor={`dlg-${feature.folder}`} command="show-modal" draggable="true" data-feature={feature.folder} data-status-line={feature.lines.status} data-moves={feature.moves.join(' ')}>
                <span class="wb-card__title">{feature.data.title}</span>
                <span class="tt-slots" aria-label={slotsLabel(feature)}>
                  {SLOTS.map((slot) => (
                    <span class:list={['tt-slot', feature.has[slot] ? 'is-on' : 'is-off']} title={feature.has[slot] ? SLOT_LABEL[slot] : SLOT_MISSING[slot]}><SlotIcon slot={slot} /></span>
                  ))}
                </span>
                {flags(feature).length > 0 && (
                  <span class="wb-card__flags">
                    {flags(feature).map((flag) => <span class={`wb-flag wb-flag--${flag.kind}`}>{flag.text}</span>)}
                  </span>
                )}
              </button>
            </li>
          ))}
        </ul>
      </section>
    );
  })}
</main>
