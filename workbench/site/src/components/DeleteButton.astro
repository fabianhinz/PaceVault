---
import { Trash } from '@lucide/astro';
import WriteForm from './WriteForm.astro';

/**
 * The one delete control of the board, for every list item and every card: writes at once,
 * the toast offers Undo (no confirm step). `label` names what goes, for the tooltip and screen
 * readers.
 */
type Props = { action: string; fields: Record<string, string>; label: string };
const props = Astro.props as Props;
---

<WriteForm action={props.action} class="wbx-inline" fields={props.fields}>
  <button type="submit" class="wb-btn wb-btn--xs wb-btn--ghost wb-del" aria-label={props.label} title={props.label}><Trash size={14} aria-hidden="true" /></button>
</WriteForm>
