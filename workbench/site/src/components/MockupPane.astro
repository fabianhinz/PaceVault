---
import type { FeatureView } from '../lib/board.ts';
import QuestionItem from './QuestionItem.astro';

/** The Mockup tab: the mockup page in an iframe, with a Questions drawer while any are open (Q14 a). */
type Props = { feature: FeatureView };
const props = Astro.props as Props;
const f = props.feature;
const open = f.questions.filter((question) => question.open);
---

<div class:list={['wbx-mock', { 'has-drawer': open.length > 0 }]}>
  <div class="wbx-mock__frame">
    <iframe data-src={`/${f.folder}/mockup/index.html`} title={`${f.data.title} · mockup`}></iframe>
  </div>
  {open.length > 0 && (
    <aside class="wbx-drawer" aria-label="Open questions">
      <p class="wbx-side__title">Open questions · {open.length}</p>
      <p class="wbx-side__sub">Answers go to <code>{`workbench/${f.folder}/plan.md`}</code>.</p>
      <ul class="wbx-items">{open.map((question) => <QuestionItem feature={f.folder} question={question} />)}</ul>
    </aside>
  )}
</div>
