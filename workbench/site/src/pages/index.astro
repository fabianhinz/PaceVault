---
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection, getEntry, render } from 'astro:content';
import { readInbox, type InboxItem } from '../../../../scripts/workbenchFrontmatter.ts';
import { checkWorkbench, workbenchRoot } from '../check.ts';
import Board from '../components/Board.astro';
import DeleteButton from '../components/DeleteButton.astro';
import FeatureDialog from '../components/FeatureDialog.astro';
import InboxDialog from '../components/InboxDialog.astro';
import { inlineMarkdown, readFeature, type FeatureView } from '../lib/board.ts';
import { fileItems } from '../lib/writeBack.ts';
import '../../../_shared/workbench.css';
import '../styles/site.css';

// Rendered per request by `astro dev`; the file watcher reloads the page after every change.
export const prerender = false;

const root = workbenchRoot();
const errors = checkWorkbench(root);
const entries = await getCollection('plans');
const features = entries
  .flatMap((entry) => {
    const feature = readFeature(root, entry.id);
    if (feature === undefined) return [];
    return [feature];
  })
  .sort(
    (a, b) =>
      a.data.created.localeCompare(b.data.created) || a.folder.localeCompare(b.folder),
  );
const visible = features.filter((feature) => feature.data.status !== 'done');
const techs = new Map(
  await Promise.all(
    visible.map(async (feature) => {
      const entry = await getEntry('techs', feature.folder);
      if (entry === undefined) return [feature.folder, undefined] as const;
      return [feature.folder, (await render(entry)).Content] as const;
    }),
  ),
);

const read = (file: string) => {
  const path = join(root, file);
  if (!existsSync(path)) return '';
  return readFileSync(path, 'utf8');
};
const inbox = readInbox(read('ideas.md'));
const flaky = fileItems(read('flaky.md')).filter((item) => /^- `/.test(item.first));

/** Neighbours in the same column, wrapping around; none for a column of one. */
const around = <T,>(list: T[], index: number) => {
  if (list.length < 2) return { prev: undefined, next: undefined };
  return {
    prev: list[(index - 1 + list.length) % list.length],
    next: list[(index + 1) % list.length],
  };
};
const column = (feature: FeatureView) =>
  visible.filter((other) => other.data.status === feature.data.status);
// "Decided by agents" steps through its own group, so the Inbox keeps today's order and peeks.
const inboxMain = inbox.filter((item) => item.section !== 'agents');
const inboxAgents = inbox.filter((item) => item.section === 'agents');
const inboxOrder: InboxItem[] = [...inboxMain, ...inboxAgents];
const inboxAround = (item: InboxItem) => {
  let list = inboxMain;
  if (item.section === 'agents') list = inboxAgents;
  return around(list, list.indexOf(item));
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>Workbench</title>
  </head>
  <body class="wb">
    {errors.length > 0 && (
      <div class="wbx-banner" role="alert">
        <strong>workbench:check fails: a plan named here is missing from the board or shown in an older state until it is fixed.</strong>
        <ul>{errors.map((error) => <li>{error}</li>)}</ul>
      </div>
    )}
    <Board features={visible} inbox={inboxOrder} />
    <footer class="wbx-foot">
      <button type="button" class="wbx-link" popovertarget="wbx-flaky">flaky.md · {flaky.length} known-flaky {flaky.length === 1 ? 'test' : 'tests'}</button>
      <span class="wbx-grow"></span>
      <span>Drag a card onto a column to set its status. The bin deletes (a card: the feature is finished), Undo in the toast. To create or edit, ask an agent.</span>
    </footer>
    <div class="wbx-pop" id="wbx-flaky" popover aria-label="Known-flaky tests">
      <p class="wbx-pop__title">workbench/flaky.md<span class="wbx-grow"></span><button type="button" class="wb-dlg__close" popovertarget="wbx-flaky" popovertargetaction="hide" aria-label="Close">✕</button></p>
      <p class="wbx-side__sub">A failing test listed here is re-run with --workers 1. Only you remove entries.</p>
      {flaky.length === 0 && <p class="wbx-empty">No known-flaky tests.</p>}
      <ul class="wbx-items">
        {flaky.map((item) => (
          <li>
            <div class="wbx-item">
              <span class="wbx-item__text" set:html={inlineMarkdown(item.first.replace(/^- /, ''))} />
              <span class="wbx-acts"><DeleteButton action="flaky.remove" fields={{ expected: item.raw }} label="Delete this entry from flaky.md" /></span>
            </div>
          </li>
        ))}
      </ul>
    </div>

    {inboxOrder.map((item) => <InboxDialog item={item} {...inboxAround(item)} />)}
    {visible.map((feature) => {
      const list = column(feature);
      const Tech = techs.get(feature.folder);
      return (
        <FeatureDialog feature={feature} {...around(list, list.indexOf(feature))}>
          {Tech && <Tech slot="tech" />}
        </FeatureDialog>
      );
    })}

    <dialog class="tt-full" aria-labelledby="tt-full-title">
      <header class="tt-full__head"><h2 id="tt-full-title" class="tt-full__title"></h2><div class="tt-full__tools"><button type="button" class="wb-dlg__close tt-full__close" aria-label="Close">✕</button></div></header>
      <div class="tt-full__body"></div>
    </dialog>
    <div class="wbx-toast" id="wbx-toast" popover="manual" role="status">
      <div class="wbx-toast__head"><span>Writes to</span><span id="wbx-toast-files"></span><span class="wbx-grow"></span><span class="wbx-toast__act" id="wbx-toast-act"></span><button type="button" class="wb-dlg__close" data-toast-close aria-label="Close">✕</button></div>
      <div id="wbx-toast-diffs"></div>
      <div class="wbx-toast__foot" id="wbx-toast-foot"></div>
    </div>
    <script src="../scripts/board.ts"></script>
  </body>
</html>
