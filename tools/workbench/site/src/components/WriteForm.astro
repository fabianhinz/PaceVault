---
/**
 * A board form that runs one write action (`data-action`, e.g. `plan.setStatus`) through
 * `actions.x(new FormData(form))`, never a plain POST. `fields` become hidden inputs: the
 * item and the lines the board rendered (`expected`, the stale-file guard).
 */
type Props = {
  action: string;
  fields: Record<string, string>;
  class?: string;
  id?: string;
  hidden?: boolean;
};
const props = Astro.props as Props;
---

<form data-action={props.action} class={props.class} id={props.id} hidden={props.hidden}>
  {Object.entries(props.fields).map((entry) => <input type="hidden" name={entry[0]} value={entry[1]} />)}
  <slot />
</form>
