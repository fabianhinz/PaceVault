---
import type { CheckItem } from '../../../scripts/frontmatter.ts';
import { inlineMarkdown } from '../lib/board.ts';
import DeleteButton from './DeleteButton.astro';
import WriteForm from './WriteForm.astro';

/**
 * One real-data check (plan.md) or agent decision (`review/decisions.md`): tick box, text,
 * Delete on hover (`actions={false}`: none).
 */
type Props = { folder: string; check: CheckItem; kind: 'check' | 'agent'; actions?: boolean };
const props = Astro.props as Props;
const check = props.check;
const first = check.raw.split('\n')[0];
const agent = props.kind === 'agent';
const why = /\s(Agent:[\s\S]*)$/.exec(check.text);
let what = check.text;
if (agent && why) what = check.text.slice(0, why.index);
let toggle = 'plan.toggleCheck';
let remove = 'plan.deleteCheck';
let label = 'Delete this real-data check';
if (agent) {
  toggle = 'review.toggleDecision';
  remove = 'review.deleteDecision';
  label = 'Delete this agent decision';
}
---

<li>
  <div class:list={['wbx-item', { 'is-done': check.checked }]}>
    <WriteForm action={toggle} class="wbx-inline" fields={{ item: props.folder, expected: first, checked: String(!check.checked) }}>
      <button type="submit" class="wbx-box" role="checkbox" aria-checked={check.checked} aria-label={check.checked ? 'Untick' : 'Tick'}>{check.checked ? '✓' : ''}</button>
    </WriteForm>
    <span class="wbx-item__text">
      <Fragment set:html={inlineMarkdown(what)} />
      {agent && why && <span class="wb-checks__why" set:html={inlineMarkdown(why[1])} />}
    </span>
    {props.actions !== false && (
      <span class="wbx-acts"><DeleteButton action={remove} fields={{ item: props.folder, expected: check.raw }} label={label} /></span>
    )}
  </div>
</li>
