---
import { inlineMarkdown, type ItemView } from '../lib/board.ts';
import CheckRow from './CheckRow.astro';
import DeleteButton from './DeleteButton.astro';

/**
 * The Review tab, the one place to review everything (Q8): the review doc in an iframe when
 * `review/index.html` exists (no placeholder without one, Q17), and the side panel with the agent
 * decisions (`review/decisions.md`, tick to confirm), the findings (`review/findings.md`,
 * written by agents from your R-labelled findings) and Accept: tick the checks, then Done in the
 * header (in review).
 */
type Props = { item: ItemView };
const props = Astro.props as Props;
const f = props.item;
const base = `tools/workbench/backlog/${f.folder}/review`;
const toConfirm = f.decisions.filter((check) => !check.checked).length;
---

<div class:list={['wbx-rv', { 'wbx-rv--nodoc': !f.reviewDoc }]}>
  {f.reviewDoc && (
    <div class="wbx-rv__doc">
      <iframe data-src={`/${f.folder}/review/index.html`} title={`${f.data.title} · review`}></iframe>
    </div>
  )}
  <aside class="wbx-findings" aria-label="Agent decisions and findings">
    <section aria-label="Agent decisions">
      <p class="wbx-side__title">Agent decisions{f.decisions.length > 0 && <span class="wbx-box__count">{toConfirm} to confirm</span>}</p>
      <p class="wbx-side__sub"><code>{`${base}/decisions.md`}</code> · tick to confirm; to overrule one, tell an agent.</p>
      {f.decisions.length === 0 && <p class="wbx-empty">No agent decisions.</p>}
      {f.decisions.length > 0 && <ul class="wbx-items">{f.decisions.map((check) => <CheckRow folder={f.folder} check={check} kind="agent" />)}</ul>}
    </section>
    <section class="wbx-rv__sec" aria-label="Findings">
      <p class="wbx-side__title">Findings</p>
      <p class="wbx-side__sub"><code>{`${base}/findings.md`}</code></p>
      {f.findings.length === 0 && <p class="wbx-empty">No findings yet.</p>}
      {f.findings.length > 0 && (
        <ul class="wbx-findings__list">
          {f.findings.map((finding) => (
            <li>
              <div class="wbx-item">
                <span class="rv-chip">{finding.id}</span>
                <span class="wbx-item__text"><span class="wb-muted">{finding.on === undefined ? 'general' : `on ${finding.on}`} · {finding.state} · </span><Fragment set:html={inlineMarkdown(finding.text)} /></span>
                <span class="wbx-acts"><DeleteButton action="review.deleteFinding" fields={{ item: f.folder, expected: finding.raw, heading: finding.heading }} label={`Delete ${finding.id}`} /></span>
              </div>
            </li>
          ))}
        </ul>
      )}
    </section>
    <section class="wbx-rv__sec" aria-label="Accept">
      <p class="wbx-side__title">Accept</p>
      <p class="wbx-side__sub">Tick the real-data checks, then press Done next to the title to accept the work (status: done). Clean up later in the chat.</p>
      {f.checks.length === 0 && <p class="wbx-empty">No real-data checks.</p>}
      {f.checks.length > 0 && <ul class="wbx-items">{f.checks.map((check) => <CheckRow folder={f.folder} check={check} kind="check" actions={false} />)}</ul>}
    </section>
  </aside>
</div>
