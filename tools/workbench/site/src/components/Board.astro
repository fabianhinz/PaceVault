---
import { Lock } from '@lucide/astro';
import type { Status } from '../../../scripts/frontmatter.ts';
import {
  LABELS,
  REASONS,
  REASON_LABEL,
  REASON_TAB,
  inlineMarkdown,
  needsYou,
  type ItemView,
} from '../lib/board.ts';
import type { Item } from '../lib/writeBack.ts';
import DeleteButton from './DeleteButton.astro';
import StatusIcon from './StatusIcon.astro';
import TypeIcon from './TypeIcon.astro';

/**
 * Needs you + one column per status, grouped into phases split by the owner gates:
 * Plan (Idea · Exploring · Planned) · gate Ready · Build (In dev · In review) · gate Done.
 * Every column the same width (workbench.css, site.css). Item cards (type icon + title, the areas
 * as a muted line that wraps) drag
 * onto the columns in `data-moves`. Needs you is derived (lib/board.ts `needsYou`): one group per
 * reason, each entry opens the card's dialog on the matching tab; below, only when `flaky.md` has
 * entries, the known-flaky tests with delete (fix or remove them). It takes no drops.
 */
type Props = { items: ItemView[]; flaky: Item[] };
const props = Astro.props as Props;
const PHASES: { label: string; gate: boolean; columns: Status[] }[] = [
  { label: 'Plan', gate: false, columns: ['idea', 'exploring', 'planned'] },
  { label: 'Gate', gate: true, columns: ['ready'] },
  { label: 'Build', gate: false, columns: ['in-dev', 'in-review'] },
  { label: 'Gate', gate: true, columns: ['done'] },
];
const GATE_TITLE = 'Owner gate: only you set this status';
const needs = needsYou(props.items);
---

<main class="wb-board" aria-label="Board">
  <div class="wbx-phase" style="--n: 1">
  <p class="wbx-phase__label" aria-hidden="true"></p>
  <div class="wbx-phase__cols">
  <section class="wb-col" aria-label={LABELS['needs-you']} data-col="needs-you">
    <h2 class="wb-col__head">
      <StatusIcon bucket="needs-you" /><span>{LABELS['needs-you']}</span>
    </h2>
    <ul class="wb-col__list">
      {needs.length === 0 && props.flaky.length === 0 && <li><p class="wbx-empty">Nothing waits on you.</p></li>}
      {REASONS.map((reason) => {
        const entries = needs.filter((entry) => entry.reason === reason);
        if (entries.length === 0) return null;
        return (
          <>
            <li class="wb-group" role="presentation"><h3 class="wb-group__head">{REASON_LABEL[reason]}</h3></li>
            {entries.map((entry) => (
              <li>
                <button type="button" class="wbx-need" data-open={`dlg-${entry.folder}`} data-open-tab={REASON_TAB[reason]} aria-label={`${entry.title}: ${REASON_LABEL[reason]}`}>
                  <span class="wbx-need__title">{entry.title}</span>
                  <span class="wbx-need__count">{entry.count}</span>
                </button>
              </li>
            ))}
          </>
        );
      })}
      {props.flaky.length > 0 && <li class="wb-group" role="presentation"><h3 class="wb-group__head" title="tools/workbench/backlog/flaky.md: a failing test listed here is re-run with --workers 1. Fix it or remove the entry.">Flaky tests</h3></li>}
      {props.flaky.map((item) => (
        <li>
          <div class="wbx-item wbx-flaky">
            <span class="wbx-item__text" set:html={inlineMarkdown(item.first.replace(/^- /, ''))} />
            <span class="wbx-acts"><DeleteButton action="flaky.remove" fields={{ expected: item.raw }} label="Delete this entry from flaky.md" /></span>
          </div>
        </li>
      ))}
    </ul>
  </section>
  </div>
  </div>
  {PHASES.map((phase) => (
    <div class:list={['wbx-phase', { 'wbx-phase--gate': phase.gate }]} style={`--n: ${phase.columns.length}`} role="group" aria-label={phase.label}>
      <p class="wbx-phase__label">{phase.label}</p>
      <div class="wbx-phase__cols">
  {phase.columns.map((status) => {
    const cards = props.items.filter((item) => item.data.status === status);
    return (
      <section class="wb-col" aria-label={LABELS[status]} data-col={status}>
        <h2 class="wb-col__head"><StatusIcon bucket={status} /><span>{LABELS[status]}</span><span class="wb-col__count">{cards.length}</span>{phase.gate && <span class="wbx-gate" title={GATE_TITLE} aria-label={GATE_TITLE}><Lock size={12} aria-hidden="true" /></span>}</h2>
        <ul class="wb-col__list">
          {cards.map((item) => (
            <li>
              <button type="button" class="wb-card" commandfor={`dlg-${item.folder}`} command="show-modal" draggable="true" data-item={item.folder} data-status-line={item.lines.status} data-moves={item.moves.join(' ')}>
                <span class="wbx-card__head">
                  {item.type !== undefined && <TypeIcon type={item.type} />}
                  <span class="wb-card__title">{item.data.title}</span>
                </span>
                {item.areas.length > 0 && <span class="wbx-areas wbx-areas--card">{item.areas.join(' · ')}</span>}
              </button>
            </li>
          ))}
        </ul>
      </section>
    );
  })}
      </div>
    </div>
  ))}
</main>
