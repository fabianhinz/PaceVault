    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.97.0",
    "astro": "7.4.0",
    "lucide-react": "^0.563.0",
    "marked": "18.1.1",
    "mermaid": "12.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shiki": "^4.5.0",
    "sirv": "3.0.2",
